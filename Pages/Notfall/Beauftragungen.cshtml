@page
@model Intranet2.Pages.Notfall.BeauftragungsModel

@{
    ViewData["Title"] = "Beauftragungen & Verantwortlichkeiten";
}

<div class="container-fluid home-page">

    <div class="home-section-header mb-4">
        <div>
            <h1 class="mb-1">Beauftragungen & Verantwortlichkeiten</h1>
            <p class="text-muted mb-0">Übersicht aller Beauftragten, Bestellten und Ernannten im Unternehmen</p>
        </div>
    </div>

    <!-- UNTERNEHMENSWEITE BEAUFTRAGUNGEN -->
    <h5 class="fw-bold mb-3" style="color: #273551;">🏢 Unternehmensweite Beauftragungen</h5>
    <div class="row g-4 mb-5">

        @foreach (var beauftragung in Model.Beauftragungen)
        {
            @foreach (var person in beauftragung.Personen)
            {
                if (person == null) continue;
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body text-center p-4">

                            <!-- FUNKTION BADGE -->
                            <span class="badge mb-3" style="background-color: #273551; font-size: 0.8rem;">
                                @beauftragung.Titel
                            </span>

                            <br />

                            <!-- FOTO-->
                            @if (!string.IsNullOrWhiteSpace(person.FotoUrl))
                            {
                                <img src="@person.FotoUrl" alt="@person.Name" class="rounded-circle mb-3" style="width: 90px; height: 90px; object-fit: cover; object-position: top;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mb-3 mx-auto" style="width: 90px; height: 90px;">
                                    <span class="text-white fw-bold fs-4">
                                        @(person.Name.Length > 0 ? person.Name[0].ToString().ToUpper() : "?")
                                    </span>
                                </div>
                            }

                            <!-- BESCHREIBUNG -->
                            <p class="text-muted small mb-3">@beauftragung.Beschreibung</p>


                            <!-- NAME -->
                            <h5 class="card-title fw-bold mb-3">@person.Name</h5>

                            <!-- KONTAKTDATEN -->
                            @if (!string.IsNullOrWhiteSpace(person.Telefon))
                            {
                                <p class="mb-1 small">
                                    📞 <a href="tel:@person.Telefon" class="text-decoration-none text-muted">
                                        @person.Telefon
                                    </a>
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(person.Mobil))
                            {
                                <p class="mb-1 small">
                                    📱 <a href="tel:@person.Mobil" class="text-decoration-none text-muted">
                                        @person.Mobil
                                    </a>
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(person.Email))
                            {
                                <p class="mb-2 small">
                                    ✉️ <a href="mailto:@person.Email" class="text-decoration-none text-muted">
                                        @person.Email
                                    </a>
                                </p>
                            }

                            <!-- TEAMS BUTTON -->
                            @if (!string.IsNullOrWhiteSpace(person.Email))
                            {
                                <a href="https://teams.microsoft.com/l/chat/0/0?users=@person.Email"
                                   target="_blank" rel="noopener noreferrer"
                                   class="btn btn-outline-primary btn-sm mt-2">
                                    💬 Teams-Nachricht
                                </a>
                            }

                        </div>
                    </div>
                </div>
            }
        }

    </div>

    <!-- HINWEIS -->
    <div class="alert alert-info d-flex gap-2 align-items-center">
        <span style="font-size: 1.3rem;">ℹ️</span>
        <div>
            Die Kontaktdaten werden automatisch aus dem Active Directory geladen.
            Bei Änderungen wende dich bitte an die IT-Abteilung.
        </div>
    </div>

</div>