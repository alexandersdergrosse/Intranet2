@page
@model Intranet2.Pages.Marktplatz.DetailsModel
@{
    ViewData["Title"] = Model.Beitrag.Titel;

    string badgeFarbe = Model.Beitrag.Kategorie switch 
    { 
        MarktplatzKategorien.Verkaufen => "primary",
        MarktplatzKategorien.Verschenken => "success", 
        MarktplatzKategorien.Gesucht => "warning", _ => "secondary" 
    };
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-page="/Marktplatz/Index" class="text-decoration-none">
            ← Zurück zum Marktplatz
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9">
            <article class="marketplace-detail">
                @if (!string.IsNullOrWhiteSpace(Model.Beitrag.BildPfad))
                {
                    <img src="@Url.Content(Model.Beitrag.BildPfad)"  alt="@Model.Beitrag.Titel" class="marketplace-detail-image" />
                }

                <div class="marketplace-detail-body">


                    <div class="marketplace-detail-meta">
                        <span class="badge bg-@badgeFarbe">
                            @Model.Beitrag.Kategorie
                        </span>

                        <span>
                            @Model.Beitrag.ErstelltAm.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    </div>

                    <h1 class="marketplace-detail-title">
                        @Model.Beitrag.Titel
                    </h1>


                    @if (Model.Beitrag.Preis.HasValue)
                    {
                        <div class="marketplace-detail-price">
                            @Model.Beitrag.Preis.Value.ToString("N2") €
                        </div>
                    }

                    <div class="marketplace-detail-description">
                        @Model.Beitrag.Beschreibung
                    </div>

                    <hr />

                    <div class="marketplace-author">
                        <div>
                            <span class="text-muted">Eingestellt von</span>
                            <strong>@Model.Beitrag.Benutzer.Name</strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Beitrag.Benutzer.Email))
                        {
                            <div class="d-flex gap-2 flex-wrap">

                                <!-- TEAMS-NACHRICHT -->
                                <a href="https://teams.microsoft.com/l/chat/0/0?users=@Model.Beitrag.Benutzer.Email" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
                                    💬 Teams-Nachricht
                                </a>

                                <!-- E-MAIL -->
                                <a href="mailto:@Model.Beitrag.Benutzer.Email"
                                   class="btn btn-outline-secondary btn-sm">
                                    ✉️ E-Mail schreiben
                                </a>

                            </div>
                        }
                    </div>


                    @if (Model.DarfLoeschen)
                    {
                        <hr />
                        <div class="d-flex gap-2">
                            <!-- BEARBEITEN-BUTTON (NEU) -->
                            <a asp-page="/Marktplatz/Bearbeiten" asp-route-id="@Model.Beitrag.Id" class="btn btn-outline-primary">
                                ✏️ Beitrag bearbeiten
                            </a>

                            <!-- LÖSCHEN-BUTTON (bereits vorhanden) -->
                            <form method="post" asp-page-handler="Loeschen" onsubmit="return confirm('Diesen Marktplatz-Beitrag wirklich löschen?');">
                                <input type="hidden" name="id" value="@Model.Beitrag.Id" />
                                <button type="submit" class="btn btn-outline-danger">
                                    🗑️ Beitrag löschen
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </article>
        </div>
    </div>
</div>