@page
@model Intranet2.Pages.Gesundheitsvorsorge.IndexModel
@{
    ViewData["Title"] = "Gesundheitsvorsorge";
}

<div class="container-fluid home-page">

    <!-- SEITENHEADER -->
    <div class="home-section-header mb-4">
        <div>
            <h1 class="mb-1">Gesundheitsvorsorge</h1>
            <p class="text-muted mb-0">Angebote und Informationen rund um deine Gesundheit</p>
        </div>
    </div>

    <!-- KARTEN-BEREICH -->
    <div class="row g-4">

        <!-- KARTE 1: Arbeitsmedizin -->
        <div class="col-xl-4 col-lg-6 col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="mb-3 mx-auto" style="width: 80px; height: 80px; border-radius: 50%; border: 2px; display: flex; align-items: center; justify-content: center; font-size: 5rem;">🩺</div>
                    <h5 class="card-title fw-bold">Cordula Hamacher</h5>
                    <p class="card-text text-muted">
                        Fachärztin für Arbeitsmedizin, Notfallmedizin, Betriebsärtzliche Betreuung, Hygienemanagement usw.<br />
                        Erreichbar unter folgender E-Mail.
                    </p>
                    <a href="mailto:hamacher@zbga-bremen.de"
                       class="btn btn-outline-primary btn-sm mt-2">
                        ✉️ hamacher@zbga-bremen.de
                    </a>
                </div>
            </div>
        </div>

        <!-- KARTE 2: Erste Hilfe -->
        <div class="col-xl-4 col-lg-6 col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="mb-3 mx-auto" style="width: 80px; height: 80px; border-radius: 50%; border: 2px; display: flex; align-items: center; justify-content: center; font-size: 5rem;">🚑</div>
                    <h5 class="card-title fw-bold">Erste Hilfe</h5>
                    <p class="card-text text-muted">
                        Ersthelfer in deiner Niederlassung und wichtige Notfallnummern.
                    </p>
                    <a asp-page="/Notfall/Ersthelfer" class="btn btn-outline-primary btn-sm mt-2">
                        🚑 Zur Erste-Hilfe-Seite →
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
