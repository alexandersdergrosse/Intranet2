@page
@model Intranet2.Pages.News.ArchivModel

@{
    ViewData["Title"] = "News-Archiv";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                News-Archiv
            </h1>

            <p class="text-muted mb-0">
                Neuigkeiten nach Jahr und Monat.
            </p>
        </div>

        <a asp-page="/News/Index" class="btn btn-outline-secondary">
            Alle Neuigkeiten
        </a>
    </div>

    @if (Model.Jahre.Count == 0)
    {
        <div class="alert alert-info">
            Es sind noch keine veröffentlichten
            Neuigkeiten vorhanden.
        </div>
    }
    else
    {
        @foreach (var jahr in Model.Jahre)
        {
            <div class="mb-5">
                <h2 class="fw-bold border-bottom pb-2">
                    @jahr.Jahr
                </h2>

                @foreach (var monat in jahr.Monate)
                {
                    <div class="mt-4 mb-4">
                        <h3 class="h5 fw-bold mb-3">
                            @monat.Name
                        </h3>

                        <div class="list-group">

                            @foreach (var news in monat.News)
                            {
                                <a asp-page="/News/Details" asp-route-id="@news.Id" class="list-group-item list-group-item-action">

                                    <div class="d-flex justify-content-between align-items-start gap-3">

                                        <div>
                                            <div class="fw-bold">
                                                @news.Titel
                                            </div>

                                            <div class="small text-muted mt-1">
                                                @news.Kurztext
                                            </div>
                                        </div>

                                        <div class="text-end">
                                            <span class="badge bg-@news.KategorieFarbe">
                                                @news.Kategorie
                                            </span>

                                            <div class="small text-muted mt-2">
                                                @news.VeroeffentlichtAm.ToString("dd.MM.yyyy")
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>