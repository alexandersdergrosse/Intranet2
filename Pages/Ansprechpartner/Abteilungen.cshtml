@page
@model Intranet2.Pages.Ansprechpartner.AbteilungenModel

@{
    ViewData["Title"] = "Abteilungen";
}

<div class="abteilungen-container">
    <a asp-page="/Ansprechpartner/Ansprechpartner" class="ansprechpartner-back-link">
        ← Zurück zu Ansprechpartner
    </a>

    <h1 class="abteilungen-title">
        Abteilungen
    </h1>

    <p class="abteilungen-description">
        Wähle eine Abteilung aus, um die zugehörigen
        Unterabteilungen und Mitarbeiter anzuzeigen.
    </p>

    <partial name="_MitarbeiterSuche" />

    @if (Model.Abteilungen.Count == 0)
    {
        <div class="alert alert-warning">
            Es wurden keine Abteilungen
            im Active Directory gefunden.
        </div>
    }
    else
    {
        <div class="abteilungen-list">
            @foreach (var abteilung in Model.Abteilungen)
            {
                bool istGeschaeftsfuehrung = string.Equals(abteilung.Name, "Geschäftsführung", StringComparison.OrdinalIgnoreCase) || string.Equals(abteilung.Name, "Geschaeftsfuehrung", StringComparison.OrdinalIgnoreCase);

                @if (istGeschaeftsfuehrung)
                {
                    <!-- Geschäftsführung besitzt keine Unterabteilung. Deshalb direkt zu den Mitarbeitern. -->
                    <a asp-page="/Ansprechpartner/Unterabteilung" asp-route-abteilung="@abteilung.Name" asp-route-direkt="true" class="abteilung-item">
                        <span class="abteilung-name">
                            @abteilung.Name
                        </span>

                        <span class="abteilung-info">
                            <span class="mitarbeiter-anzahl">
                                @abteilung.Mitarbeiter.Count
                                Mitarbeiter
                            </span>

                            <span class="abteilung-arrow">
                                →
                            </span>
                        </span>
                    </a>
                }
                else
                {
                    <!-- Normale Abteilung: zuerst Unterabteilungen anzeigen. -->
                    <a asp-page="/Ansprechpartner/Abteilung" asp-route-abteilung="@abteilung.Name" class="abteilung-item">
                        <span class="abteilung-name">
                            @abteilung.Name
                        </span>

                        <span class="abteilung-info">
                            <span class="mitarbeiter-anzahl">
                                @abteilung.Mitarbeiter.Count
                                Mitarbeiter
                            </span>

                            <span class="abteilung-arrow">
                                →
                            </span>
                        </span>
                    </a>
                }
            }
        </div>
    }
</div>