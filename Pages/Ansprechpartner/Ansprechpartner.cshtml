        <!-- RECHTE SEITE -->
        <div class="map-container">

            <div class="map-title">
                Unsere Standorte
            </div>


            <div class="deutschland-map">

                <img src="~/Images/deutschlandkarte.png" asp-append-version="true" alt="Deutschlandkarte mit Kreutzträger Standorten" />

                <!-- FLENSBURG -->
