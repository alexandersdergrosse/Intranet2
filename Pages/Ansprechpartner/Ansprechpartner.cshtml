                    <span class="map-marker-label">
                        Recklinghausen
                    </span>
                </a>

                <!-- BERGHEIM -->
                <a asp-page="/Ansprechpartner/Standort" asp-route-niederlassung="Bergheim" class="map-marker" style="left: 10.5%; top: 52.7%;" aria-label="Ansprechpartner Bergheim">
                    <span class="map-marker-label">
