                    </span>
                </a>

                <!-- FÜRTH -->
                <a asp-page="/Ansprechpartner/Standort" asp-route-niederlassung="Fürth" class="map-marker" style="left: 55.0%; top: 69.2%;" aria-label="Ansprechpartner Fürth">
                    <span class="map-marker-label">
                        Fürth
                    </span>
                </a>

                <!-- LINDENBERG -->
                <a asp-page="/Ansprechpartner/Standort" asp-route-niederlassung="Lindenberg" class="map-marker" style="left: 44.6%; top: 91.6%;" aria-label="Ansprechpartner Lindenberg">
                    <span class="map-marker-label">
                        Lindenberg
                    </span>
                </a>
            </div>

        </div>

    </div>

</div>