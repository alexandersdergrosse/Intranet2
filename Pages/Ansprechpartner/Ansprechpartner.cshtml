            <a asp-page="/Ansprechpartner/Standort" asp-route-niederlassung="Hamburg" class="city-item">

                <span>Hamburg</span>
                <span class="arrow">ℹ️</span>

            </a>


            <a asp-page="/Ansprechpartner/Standort" asp-route-niederlassung="Osnabrück" class="city-item">

                <span>Osnabrück</span>
                <span class="arrow">ℹ️</span>

            </a>


            <a asp-page="/Ansprechpartner/Standort" asp-route-niederlassung="Recklinghausen" class="city-item">

