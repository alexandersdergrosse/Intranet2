@page
@model Intranet2.Pages.Ansprechpartner.AnsprechpartnerModel

@{
    ViewData["Title"] = "Ansprechpartner";
}

<style>
    /* ========================================
           ANSPRECHPARTNER
           ======================================== */

    .ansprechpartner-container {
        font-family: Arial, sans-serif;
        max-width: 1200px;
        margin: 0 auto;
        padding: 25px 20px 20px 20px;
    }

    .main-title {
        font-size: 2.3em;
        font-weight: bold;
        color: #333;
        text-align: center;
        margin-bottom: 20px;
    }


    /* ========================================
           HAUPTLAYOUT
           ======================================== */

    .ansprechpartner-content {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 80px;
        align-items: start;
    }


    /* ========================================
           STANDORTLISTE
           ======================================== */

    .city-list-container {
        width: 100%;
    }

    a.city-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 0;
        border-bottom: 2px solid #4f7cff;
        font-size: 1.1rem;
        color: #333;
        text-decoration: none;
        transition: background-color 0.2s ease, padding-left 0.2s ease;
    }

        a.city-item:hover {
            background-color: #f0f8ff;
            padding-left: 8px;
        }

    .arrow {
        font-size: 1.1rem;
        margin-left: 10px;
    }


    /* ========================================
           KARTENBEREICH
           ======================================== */

    .map-container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .map-title {
        color: #273551;
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 10px;
        text-align: center;
    }


    /* ========================================
           DEUTSCHLANDKARTE

           Das Bild ist 1024 x 1536 Pixel.
           Das entspricht exakt 2 : 3.
           ======================================== */

    .deutschland-map {
        position: relative;
        width: min(100%, 330px);
        aspect-ratio: 2 / 3;
        margin: 0 auto;
    }

        .deutschland-map > img {
            position: absolute;
            inset: 0;
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
            border: none;
            border-radius: 0;
            box-shadow: none;
            background: transparent;
            pointer-events: none;
        }


    /* ========================================
           MARKER
           ======================================== */

    .map-marker {
        position: absolute;
        width: 14px;
        height: 14px;
        transform: translate(-50%, -50%);
        background-color: #e30613;
        border: 2px solid white;
        border-radius: 50%;
        box-shadow: 0 0 0 1px rgba(227, 6, 19, 0.45), 0 2px 5px rgba(0, 0, 0, 0.25);
        cursor: pointer;
        z-index: 10;
        transition: transform 0.15s ease, background-color 0.15s ease;
    }

        .map-marker:hover,
        .map-marker:focus {
            background-color: #0091b6;
            transform: translate(-50%, -50%) scale(1.4);
            z-index: 20;
            outline: none;
        }


    /* ========================================
           MARKER-NAME
           ======================================== */

    .map-marker-label {
        position: absolute;
        left: 50%;
        bottom: 21px;
        transform: translateX(-50%);
        padding: 4px 8px;
        background-color: #273551;
        color: white;
        border-radius: 5px;
        font-size: 0.75rem;
        font-weight: 600;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.15s ease, visibility 0.15s ease;
    }

        .map-marker-label::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border-width: 5px;
            border-style: solid;
            border-color: #273551 transparent transparent transparent;
        }

    .map-marker:hover .map-marker-label,
    .map-marker:focus .map-marker-label {
        opacity: 1;
        visibility: visible;
    }


    /* ========================================
           RESPONSIVE
           ======================================== */

    @@media (max-width: 991px) {

        .ansprechpartner-content {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .city-list-container {
            max-width: 500px;
            margin: 0 auto;
        }

        .deutschland-map {
            width: min(100%, 320px);
        }
    }

    @@media (max-width: 575px) {

        .ansprechpartner-container {
            padding-left: 15px;
            padding-right: 15px;
        }

        .main-title {
            font-size: 2rem;
        }

        .deutschland-map {
            width: min(100%, 290px);
        }
    }
</style>


<div class="ansprechpartner-container">

    <h1 class="main-title">
        @ViewData["Title"]
    </h1>

    <partial name="_MitarbeiterSuche" />

    <div class="ansprechpartner-content">

        <!-- LINKE SEITE -->
        <div class="city-list-container">

            <a asp-page="/Ansprechpartner/Standort" asp-route-niederlassung="Bremen" class="city-item">

                <span>Bremen</span>
                <span class="arrow">ℹ️</span>

            </a>


            <a asp-page="/Ansprechpartner/Standort" asp-route-niederlassung="Flensburg" class="city-item">

