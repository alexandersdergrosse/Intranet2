@page
@model Intranet2.Pages.Ansprechpartner.AbteilungModel

@{
    ViewData["Title"] = Model.Abteilung;
}

<div class="abteilungen-container">
    <!-- Zurück -->
    <div class="mb-4">
        <a asp-page="/Ansprechpartner/Abteilungen" class="text-decoration-none">
            ← Zurück zu Abteilungen
        </a>
    </div>

    <!-- Überschrift -->
    <h1 class="abteilungen-title">
        @Model.Abteilung
    </h1>

    <p class="abteilungen-description">
        Wähle eine Unterabteilung aus,
        um die zugehörigen Mitarbeiter anzuzeigen.
    </p>

    @if (Model.Unterabteilungen.Count == 0)
    {
        <div class="alert alert-warning">
            Für die Abteilung
            <strong>
                @Model.Abteilung
            </strong>
            wurden keine Unterabteilungen
            im Active Directory gefunden.
        </div>
    }
    else
    {
        <div class="abteilungen-list">
            @foreach (var unterabteilung in Model.Unterabteilungen)
            {
                <a asp-page="/Ansprechpartner/Unterabteilung" asp-route-abteilung="@Model.Abteilung" asp-route-unterabteilung="@unterabteilung.Name" class="abteilung-item">
                    <span class="abteilung-name">
                        @unterabteilung.Name
                    </span>

                    <span class="abteilung-info">
                        <span class="mitarbeiter-anzahl">
                            @unterabteilung.Mitarbeiter.Count

                            @if (unterabteilung.Mitarbeiter.Count == 1)
                            {
                                <text>Mitarbeiter</text>
                            }
                            else
                            {
                                <text>Mitarbeiter</text>
                            }
                        </span>

                        <span class="abteilung-arrow">
                            →
                        </span>
                    </span>
                </a>
            }
        </div>
    }
</div>